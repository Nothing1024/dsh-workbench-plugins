{
  "name": "dsh-plugin-herdr-live",
  "version": "0.1.0",
  "description": "Herdr / Ovis DSH 工作台插件：原生项目与终端侧栏、主区 iframe，以及接入 URL 与本机代理设置。",
  "type": "module",
  "main": "index.js",
  "files": [
    "cordis.patch.yml",
    "client.js",
    "embed-bridge.js",
    "index.js",
    "prefs.mjs",
    "proxy.mjs",
    "sidebar-channel.mjs",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "herdr",
    "ovis",
    "workbench"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/REPLACE_ME/dsh-workbench-plugins.git",
    "directory": "packages/herdr-live"
  },
  "homepage": "https://github.com/REPLACE_ME/dsh-workbench-plugins#readme",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=22.4.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "dsh-plugin-workbench-sources",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ],
      "external": [
        "react",
        "react-dom",
        "dsh-plugin-workbench-sources"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "dsh-plugin-workbench-sources": "^0.1.0"
  }
}
